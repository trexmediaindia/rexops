NODE_ENV=test
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:8080
# The suite runs against its own database, never the one `bun run dev` is using:
# `ensureTestFixtures()` and the write paths under test insert rows, and a test run
# should not be able to disturb the data you are looking at in the browser.
# Port 5433 is the compose default (5432 is occupied on far too many machines).
# Override any of this in .env.test.local, which is gitignored and loaded last.
DATABASE_URL=postgres://rexops:rexops@localhost:5433/rexops_test
DATABASE_URL_UNPOOLED=postgres://rexops:rexops@localhost:5433/rexops_test
BETTER_AUTH_SECRET=test-secret-that-is-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
REDIS_URL=redis://localhost:6379/1
OPENFEATURE_PROVIDER=memory
VITE_API_URL=http://localhost:3001
VITE_LIVEBLOCKS_AUTH_URL=http://localhost:3001/api/liveblocks-auth
FEATURE_FILES_VERSIONING=true
FEATURE_REVIEW_WEDGE=true
FEATURE_COLLABORATION_LIVE=true
FEATURE_WORK_VIEWS=true
FEATURE_AUTOMATION=true
FEATURE_ANALYTICS=true
