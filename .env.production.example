# Production settings for docker-compose.prod.yml. scripts/server-setup.sh creates the real
# file (.env.production, gitignored) on the server with fresh random secrets; this template
# documents what it contains. Never commit the real file.

# --- Where the app lives -------------------------------------------------------------------
# SITE_ADDRESS is the bare hostname Caddy gets an HTTPS certificate for; PUBLIC_ORIGIN is the
# full URL people open. All the *_URL values below are the same origin: Caddy sends /api/*
# to the API and everything else to the web app.
SITE_ADDRESS=ops.example.com
PUBLIC_ORIGIN=https://ops.example.com

NODE_ENV=production
API_PORT=3000
API_URL=https://ops.example.com
WEB_URL=https://ops.example.com
BETTER_AUTH_URL=https://ops.example.com

# --- Generated secrets (server-setup.sh fills these with `openssl rand`) -------------------
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
LOCAL_STORAGE_SIGNING_SECRET=

# Written out in full (not ${...}) so it reads the same to Compose and to the containers.
DATABASE_URL=postgres://rexops:<POSTGRES_PASSWORD>@postgres:5432/rexops
DATABASE_URL_UNPOOLED=postgres://rexops:<POSTGRES_PASSWORD>@postgres:5432/rexops
REDIS_URL=redis://redis:6379

# Uploaded and processed media, on a Docker volume shared by the API and the worker.
LOCAL_STORAGE_DIRECTORY=/app/.data/object-storage
MEDIA_WORKER_CONCURRENCY=2
NOTIFY_WORKER_CONCURRENCY=8
AUTOMATION_WORKER_CONCURRENCY=4
OPENFEATURE_PROVIDER=memory

# --- Features -------------------------------------------------------------------------------
# Production defaults every feature to off. These two are the core product (uploads, versions,
# the review room and approvals). Blocks 5-7 (work views, automation, analytics) are marked
# unreleased in docs/08-implementation-status.md; turn them on once you have tried them.
FEATURE_FILES_VERSIONING=true
FEATURE_REVIEW_WEDGE=true
FEATURE_WORK_VIEWS=false
FEATURE_AUTOMATION=false
FEATURE_ANALYTICS=false
# Inbox, chat and live presence. Needs LIVEBLOCKS_SECRET_KEY in production or it stays off.
FEATURE_COLLABORATION_LIVE=false

# --- Optional services: leave blank until you create your own accounts ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
LIVEBLOCKS_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=
POSTHOG_KEY=
SENTRY_DSN=
VITE_SENTRY_DSN=
# Cloudflare R2 instead of the server's disk for media. Leave blank to use the disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rexops-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# --- Creative Dock landing page (landing/) --------------------------------------------------
# The public early-access page. Point an A record for the subdomain at this server, then set
# LANDING_ADDRESS to that hostname. Requests are read at https://<LANDING_ADDRESS>/admin with
# the login below; without a password the inbox stays locked.
LANDING_ADDRESS=dock.example.com
LANDING_ADMIN_USER=admin
LANDING_ADMIN_PASSWORD=
# Email for every new request. Uses RESEND_API_KEY above. LANDING_NOTIFY_TO takes one or more
# addresses separated by commas. LANDING_NOTIFY_FROM must be on a domain verified in Resend;
# left blank it falls back to EMAIL_FROM, then to Resend's test sender, which only delivers to
# the email address that owns the Resend account.
LANDING_NOTIFY_TO=
LANDING_NOTIFY_FROM=
