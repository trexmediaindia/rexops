{
  "name": "@rexops/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external postgres",
    "check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "seed": "bun src/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.3.1",
    "@rexops/config": "workspace:*",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  }
}
